<?xml version="1.0" encoding="utf-8"?>
<!--
  DATUM installer.

  Per-user by default. The SOLIDWORKS add-in registers under HKCU and the orchestrator
  listens on loopback, so nothing here needs administrator rights — and requiring
  elevation on a locked-down engineering desktop is the difference between a product
  someone can try this afternoon and one that waits three weeks for IT.

  Build:
    wix build installers\DATUM.wxs -o dist\DATUM.msi -arch x64
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="DATUM for SOLIDWORKS"
           Manufacturer="DATUM"
           Version="0.1.0.0"
           UpgradeCode="7C1E4A93-2D5B-4F86-9E33-5A7B0C2D8E41"
           Scope="perUser"
           Compressed="yes">

    <!-- Upgrades replace in place rather than stacking side-by-side installs. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of DATUM is already installed. Uninstall it first." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Prerequisites. Failing here with a readable message beats installing successfully
      and then failing at first launch with a missing-DLL dialog.
    -->
    <Property Id="WEBVIEW2RUNTIME">
      <RegistrySearch Id="WebView2Search"
                      Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR WEBVIEW2RUNTIME"
            Message="DATUM needs the Microsoft Edge WebView2 Runtime. Install it from https://go.microsoft.com/fwlink/p/?LinkId=2124703 and run this installer again." />

    <Launch Condition="Installed OR (VersionNT >= 603)"
            Message="DATUM requires Windows 10 or later." />

    <Feature Id="Main" Title="DATUM" Level="1">
      <ComponentGroupRef Id="OrchestratorFiles" />
      <ComponentGroupRef Id="StudioFiles" />
      <ComponentGroupRef Id="UiFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="DATUM">
        <Directory Id="UIFOLDER" Name="ui" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="DATUM" />
    </StandardDirectory>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <!--
      File payloads are declared here rather than harvested, so the installer contents are
      reviewable in source control. A harvested manifest silently picks up whatever
      happens to be in the output folder, including yesterday's build artefacts.
    -->
    <ComponentGroup Id="OrchestratorFiles" Directory="INSTALLFOLDER">
      <Component Id="OrchestratorExe" Guid="*">
        <File Id="OrchestratorExeFile"
              Source="$(var.PublishDir)\DATUM.Orchestrator.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="StudioFiles" Directory="INSTALLFOLDER">
      <Component Id="StudioExe" Guid="*">
        <File Id="StudioExeFile"
              Source="$(var.StudioDir)\DATUM.Studio.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

<!--
      UiFiles is generated by installers\build.ps1 into UiAssets.g.wxs.

      Vite content-hashes asset filenames on every build, so a static list here would go
      stale the moment anyone edited a stylesheet — and the installer would ship an
      index.html referencing assets that are not in the package. That installs cleanly and
      then renders a blank window, which is the worst kind of failure: silent at build
      time, obvious only to the customer.
    -->

    <ComponentGroup Id="Shortcuts" Directory="AppMenuFolder">
      <Component Id="StudioShortcut" Guid="*">
        <Shortcut Id="StudioStartMenu"
                  Name="DATUM Studio"
                  Description="AI design copilot for SOLIDWORKS"
                  Target="[INSTALLFOLDER]DATUM.Studio.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <!-- Per-user installs must clean up their own Start-menu folder. -->
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\DATUM"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
