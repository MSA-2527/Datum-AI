<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Out-of-process by design. This is where the local LLM (GBs of RAM, GPU), the
    embedding index and the batch scheduler live — none of which belong inside
    SLDWORKS.exe. It also means history and queued batches survive a SOLIDWORKS crash.
  -->
  <!--
    net8.0-windows, not net8.0.

    This service is Windows-only in substance, not by accident: it restricts the named
    pipe ACL to the interactive user's SID, and it exists to talk to SOLIDWORKS. Declaring
    the platform is the honest fix for the CA1416 warnings on PipeSecurity and
    WindowsIdentity — suppressing them would hide a real portability claim we cannot make.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Datum.Orchestrator</RootNamespace>
    <AssemblyName>DATUM.Orchestrator</AssemblyName>
    <OutputType>Exe</OutputType>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DATUM.Contracts\DATUM.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />

    <!--
      PipeSecurity, PipeAccessRule and NamedPipeServerStreamAcl are not in the .NET
      shared framework; they live in this Windows-only compatibility package. Without
      it Transport/PipeServer.cs does not compile, and restricting the pipe ACL to the
      interactive user's SID is the whole reason we use named pipes over a socket.
    -->
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />

    <!--
      DPAPI. Provider API keys are encrypted at rest scoped to the current user, so the
      ciphertext is useless to another account on the machine and useless on any other
      machine. Environment variables leak into child processes and crash dumps.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
