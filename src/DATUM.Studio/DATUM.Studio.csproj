<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF, not Electron.

    The UI is already a web bundle, so the shell's only job is to host WebView2 and manage
    the orchestrator connection. WPF does that in a few hundred KB against a runtime the
    machine already has, whereas Electron would ship a second Chromium alongside the one
    WebView2 uses — on a workstation already running SOLIDWORKS, that is memory taken from
    the CAD kernel.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Datum.Studio</RootNamespace>
    <AssemblyName>DATUM.Studio</AssemblyName>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The WebView2 control brings its own; ours would be a duplicate. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
